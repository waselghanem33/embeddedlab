</FIELDS>
<KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/><KEY NAME="coursefk" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/><KEY NAME="userfk" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/></KEYS>
<INDEXES><INDEX NAME="courseuserassignment" UNIQUE="true" FIELDS="courseid, userid, assignmentid"/></INDEXES>
</TABLE>
</TABLES>
</XMLDB>
